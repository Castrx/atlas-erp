# Atlas ERP — variáveis de ambiente (EXEMPLO).
# Nenhum valor real deve ser versionado — os valores abaixo são placeholders
# fictícios. Copie para um .env e ajuste antes de qualquer ambiente que não
# seja desenvolvimento local.
#
# IMPORTANTE: o backend (Spring Boot) NÃO lê .env automaticamente. Exporte
# as variáveis (ou configure-as no run config do seu IDE) antes de
#   ./mvnw spring-boot:run
# O docker-compose (pasta docker/) lê um arquivo .env do diretório onde o
# comando é executado, ou use: docker compose --env-file ../.env up -d postgres.

# --- Banco de dados (backend) ---
# Defaults DEV-ONLY do application.yml (aplicam quando a variável não existe).
DB_URL=jdbc:postgresql://localhost:5432/atlas_erp
DB_USERNAME=atlas
# Gere uma senha forte; o default da aplicação é o placeholder CHANGE_ME_DB_PASSWORD.
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# --- JWT (backend) ---
# Secret de assinatura HS256 — exija >= 32 bytes (256 bits). Gere com:
#   openssl rand -base64 48
JWT_SECRET=CHANGE_ME_JWT_SECRET
# Expiração em milissegundos (default: 24h).
JWT_EXPIRATION=86400000

# --- Bootstrap do primeiro ADMIN (AE-045) ---
# Defina as duas variáveis para criar o ADMIN na primeira subida do backend
# (uma instalação nova, sem nenhum usuário). Idempotente: se o e-mail já
# existir, nada é feito. Remova as variáveis depois de criar o ADMIN.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_BOOTSTRAP_NAME=Administrador

# --- PostgreSQL / pgAdmin (docker-compose) ---
# Aplicam-se apenas na CRIAÇÃO do container (volume novo). Se já havia um
# volume antigo, recrie-o (docker compose down -v) para aplicar os valores.
POSTGRES_DB=atlas_erp
POSTGRES_USER=atlas
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD
PGADMIN_DEFAULT_EMAIL=admin@atlas.local
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_PGADMIN_PASSWORD
