# --- IDE / editor ---
.idea/
.vscode/
*.iml
*.ipr
*.iws

# --- OS ---
.DS_Store
Thumbs.db

# --- Java / Maven (por app) ---
# O atlas-backend tem .gitignore próprio (target/, etc.); a raiz cobre resíduos.

# --- Node / frontend (por app) ---
# O atlas-frontend tem .gitignore próprio (node_modules/, dist/, etc.).

# --- Logs ---
logs/
*.log
npm-debug.log*

# --- Ambiente / segredos ---
# .env contém valores reais e NUNCA deve ser versionado.
# .env.example é o modelo permitido.
.env
.env.*
!.env.example

# --- Compilados / empacotados (default Maven) ---
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# --- Outros resíduos ---
*.ctxt
.mtj.tmp/
hs_err_pid*
replay_pid*
