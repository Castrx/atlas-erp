# Atlas ERP — Docker Compose: variáveis de ambiente (EXEMPLO).
# Nenhum valor real deve ser versionado — os valores abaixo são placeholders
# fictícios. Copie para docker/.env (ignorado pelo Git) e ajuste.
#
# O docker compose lê o .env do diretório onde o comando é executado:
#   cd docker && docker compose up --build

# --- PostgreSQL ---
# Aplicam-se apenas na CRIAÇÃO do volume (atlas_erp_postgres_data). O backend
# do Compose usa automaticamente estas mesmas credenciais (mesma interpolação).
POSTGRES_DB=atlas_erp
POSTGRES_USER=atlas
POSTGRES_PASSWORD=CHANGE_ME_DB_PASSWORD

# --- Backend ---
# JWT secret de assinatura HS256 — exija >= 32 bytes (256 bits) fora de dev.
# Gere com: openssl rand -base64 48. Se não definir, o placeholder DEV-ONLY
# do compose/application.yml é usado (suficiente para dev local).
JWT_SECRET=CHANGE_ME_JWT_SECRET__AT_LEAST_32_BYTES_0123456789
# Primeiro ADMIN (idempotente) — defina APENAS na primeira subida de uma
# instalação nova; remova depois. Vazio = runner inerte.
ADMIN_BOOTSTRAP_EMAIL=admin@example.com
ADMIN_BOOTSTRAP_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
ADMIN_BOOTSTRAP_NAME=Administrador
# Dados de demonstração (idempotentes) — true cria empresa, categorias,
# produtos, clientes, vendas e movimentos de estoque na primeira subida do
# backend. Ausente/false = runner inerte. Use apenas em ambiente de demo.
DEMO_DATA=false

# --- pgAdmin (opcional) ---
PGADMIN_DEFAULT_EMAIL=admin@atlas.local
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_PGADMIN_PASSWORD
